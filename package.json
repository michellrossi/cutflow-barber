{
  "name": "cutflow-barber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/server.js --packages=external",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@google/generative-ai": "^0.22.0",
    "@supabase/supabase-js": "2",
    "@types/express": "^5.0.6",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "dompurify": "3.0.9",
    "dotenv": "^17.3.1",
    "emoji-picker-react": "^4.18.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "6.22.3",
    "recharts": "^2.12.2",
    "resend": "^6.12.2",
    "timezone": "^1.0.23",
    "utc": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "playwright": "^1.59.1",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.5"
  }
}
