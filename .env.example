
# Configurações de IA (Gemini)
GEMINI_API_KEY=

# Configurações de WhatsApp (Exemplo: Twilio, Z-API, etc.)
# Se não preenchido, o sistema rodará em modo SIMULAÇÃO (log no console)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Supabase (Necessário para o servidor acessar o banco e enviar lembretes)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
