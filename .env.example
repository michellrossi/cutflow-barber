# Configurações de IA (Gemini)
GEMINI_API_KEY=seu_token_aqui

# Configurações de WhatsApp (Evolution API)
WHATSAPP_API_URL=https://sua-evolution-api.com
WHATSAPP_API_KEY=sua_api_key_aqui

# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Token de segurança para o Cron Job
CRON_SECRET=um_token_seguro_aqui

# Server URL (URL base do seu servidor/frontend)
SERVER_URL=http://localhost:5173

# Asaas - Pagamentos
ASAAS_API_KEY=seu_token_asaas_aqui
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=seu_webhook_token_definido_no_painel_asaas

# Proteção SaaS (Acesso ao painel /admin/saas)
SAAS_ADMIN_KEY=seu_token_admin_aqui

# E-mail do Administrador Mestre
ADMIN_EMAIL=admin@exemplo.com
